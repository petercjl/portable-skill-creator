        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "target": {
        "field": "target",
        "type": "string"
      },
      "installed": {
        "field": "installed",
        "type": "boolean"
      },
      "managed": {
        "field": "managed",
        "type": "boolean"
      },
      "current": {
        "field": "current",
        "type": "boolean"
