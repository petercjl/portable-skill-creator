      "verification": {
        "field": "verification",
        "type": "object"
      },
      "recovery": {
        "field": "recovery",
        "type": "object"
      }
    },
    "targetOptions": {
      "--target": {
        "kind": "skill-directory"
      }
    },
    "agentEligibility": "valid-name-with-generic-fallback",
    "hostDiscoveryAuthority": "host"
  },
  "discoveryContract": {
    "schemaVersion": 1,
    "entryPoints": [
      {
        "argv": [
          "capabilities",
          "--json"
        ],
        "result": "manifest"
      }
    ],
    "commandsField": "commandContracts",
    "version": {
      "command": "version",
      "argv": [
        "version",
        "--json"
      ],
      "fields": {
        "package": {
          "field": "package",
          "type": "string"
        },
        "version": {
          "field": "version",
          "type": "string"
        }
      }
    },
    "skillCollection": {
      "namesField": "skills",
      "default": "portable-skill-creator",
      "selector": {
        "option": "--name",
        "type": "string"
      },
      "enumeration": {
        "argv": [
          "skill",
          "source",
          "--json"
        ],
        "itemsField": "skills",
        "completeField": "complete"
      },
      "namedSource": [
        "skill",
        "source",
        "--name",
        "{skill}",
        "--json"
      ]
    }
  },
  "installationLifecycle": {
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "source": [
      "skill",
      "source",
      "--json"
    ],
    "install": "skill install --agent {agent} --target {target} --json",
    "update": "update install --agent {agent} --target {target} --yes --json",
    "verification": "skill status --agent {agent} --target {target} --json",
    "hostDiscoveryAuthority": "host",
    "physicalIsolation": true,
    "runtimeEntry": "{target}/.runtime/bin/portable-skill-creator.mjs",
    "agentNeutral": true,
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true
  },
  "automaticUpdates": {
    "trigger": "ordinary task entry prepare and validate",
    "channel": "latest",
    "ttlHours": 24,
    "timeoutMs": 1500,
    "optOut": "PORTABLE_SKILL_UPDATE_CHECK=0",
    "automaticInstall": false,
    "policy": "advisory-only; explicit install authorization required",
    "enabledByDefault": true,
    "intervalHours": 24,
    "configuration": "update status --json; optional explicit --state-dir",
    "disable": "PORTABLE_SKILL_UPDATE_CHECK=0",
    "recovery": "offline backoff keeps installed state; malformed cache is preserved",
    "defaultMode": "notify"
  },
  "historicalUpdater": {
    "status": "first-release",
    "previousPublishedVersions": []
  },
  "generationAssets": {
    "nodeLedger": {
      "path": "skills/portable-skill-creator/assets/node-ledger",
      "runtime": "Python >=3.10 standard library",
      "scope": "target-owned file-based DAG runs",
      "operations": [
        "init",
        "start",
        "finish",
        "inspect",
        "plan",
        "invalidate",
        "revise"
      ],
      "schemaVersion": 1
    }
  }
